---
import { getSiteData, getAllPosts, mediaUrl } from '../../lib/api'
import SiteLayout from '../../layouts/SiteLayout.astro'
import { SITE_SLUG } from '../../lib/api'

const { site, settings } = await getSiteData()
const posts = await getAllPosts(site.id)
---

<SiteLayout siteSlug={SITE_SLUG} settings={settings} pageTitle="وبلاگ">
  <section class="sf-section" dir="rtl">
    <div class="sf-container">
      <header class="blog-header">
        <h1 class="blog-title">وبلاگ</h1>
        <p class="blog-sub">آخرین مقالات و اخبار</p>
      </header>

      {posts.length === 0
        ? <p class="blog-empty">هنوز مقاله‌ای منتشر نشده است.</p>
        : (
          <div class="blog-grid">
            {posts.map((post: any) => {
              const img = post.featuredImage && typeof post.featuredImage === 'object' ? post.featuredImage : null
              const imgSrc = img ? (img.url || `/api/media/file/${img.filename}`) : null
              const date = post.publishedAt
                ? new Intl.DateTimeFormat('fa-IR', { year:'numeric', month:'long', day:'numeric' }).format(new Date(post.publishedAt))
                : null
              return (
                <article class="blog-card">
                  <a href={`/blog/${post.slug}`} class="blog-card__link">
                    <div class="blog-card__img">
                      {imgSrc
                        ? <img src={imgSrc} alt={img?.alt || post.title} loading="lazy" />
                        : <div class="blog-card__placeholder" />
                      }
                    </div>
                    <div class="blog-card__body">
                      {Array.isArray(post.categories) && post.categories.length > 0 && (
                        <div class="blog-card__cats">
                          {post.categories.slice(0,2).map((c: any) => (
                            <span class="blog-card__cat">{typeof c === 'string' ? c : c.title || c.slug}</span>
                          ))}
                        </div>
                      )}
                      <h2 class="blog-card__title">{post.title}</h2>
                      {post.excerpt && <p class="blog-card__excerpt">{post.excerpt}</p>}
                      <div class="blog-card__meta">
                        {date && <time datetime={post.publishedAt}>{date}</time>}
                        <span class="blog-card__more">ادامه مطلب ←</span>
                      </div>
                    </div>
                  </a>
                </article>
              )
            })}
          </div>
        )
      }
    </div>
  </section>
</SiteLayout>

<style>
.blog-header { text-align:center; margin-bottom:48px; }
.blog-title { font-size:2.2rem; font-weight:800; color:var(--sf-text); }
.blog-sub { color:var(--sf-text-muted); margin-top:8px; font-size:1.05rem; }
.blog-empty { text-align:center; color:var(--sf-text-muted); padding:40px; }
.blog-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:28px; }
.blog-card { border-radius:var(--sf-radius); overflow:hidden; background:#fff; border:1px solid var(--sf-border); box-shadow:0 4px 20px rgba(2,6,23,.05); transition:transform .2s,box-shadow .2s; }
.blog-card:hover { transform:translateY(-4px); box-shadow:0 12px 40px rgba(2,6,23,.1); }
.blog-card__link { display:block; color:inherit; text-decoration:none; }
.blog-card__img { aspect-ratio:16/9; overflow:hidden; background:var(--sf-muted); }
.blog-card__img img { width:100%; height:100%; object-fit:cover; transition:transform .3s; }
.blog-card:hover .blog-card__img img { transform:scale(1.04); }
.blog-card__placeholder { width:100%; height:100%; background:linear-gradient(135deg,#e2e8f0,#f1f5f9); }
.blog-card__body { padding:20px 24px 24px; display:flex; flex-direction:column; gap:10px; }
.blog-card__cats { display:flex; gap:8px; flex-wrap:wrap; }
.blog-card__cat { padding:3px 10px; background:rgba(37,99,235,.08); color:var(--sf-primary); font-size:.8rem; font-weight:600; border-radius:20px; }
.blog-card__title { font-size:1.1rem; font-weight:700; color:var(--sf-text); line-height:1.5; }
.blog-card__excerpt { color:var(--sf-text-muted); font-size:.9rem; line-height:1.7; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.blog-card__meta { display:flex; align-items:center; justify-content:space-between; font-size:.85rem; color:var(--sf-text-muted); margin-top:auto; padding-top:12px; border-top:1px solid var(--sf-border); }
.blog-card__more { color:var(--sf-primary); font-weight:600; }
@media (max-width: 900px) { .blog-grid { grid-template-columns:repeat(2,1fr); } }
@media (max-width: 600px) { .blog-grid { grid-template-columns:1fr; } }
</style>
